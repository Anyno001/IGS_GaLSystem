  "styleChecks": {
    "viewportLeft": "left:var(--igs-settings-vleft)",
    "viewportTop": "top:var(--igs-settings-vtop)",
    "viewportWidth": "width:var(--igs-settings-vw)",
    "viewportHeight": "height:var(--igs-settings-vh)",
    "shellWidth": "width:var(--igs-settings-width)",
    "headerHeight": "height:54px",
    "segmentedHeight": "height:40px",
    "switchHeight": "height:38px",
    "radiusShell": "--igs-settings-radius-shell:8px",
    "radiusControl": "--igs-settings-radius-control:6px",
    "radiusSmall": "--igs-settings-radius-small:4px",
    "flatShell": "background:var(--igs-settings-shell-bg);border:0;border-radius:var(--igs-settings-radius-shell);box-shadow:none",
    "flatBackdrop": "backdrop-filter:none",
    "themeSwitch": ".igs-settings-theme-switch{display:inline-flex;align-items:center;gap:5px",
    "themeSwatch": ".igs-settings-theme-option{position:relative;width:20px;height:20px",
    "segmentedDynamicSpacing": ".igs-segmented{--igs-segment-pad:clamp(0px,calc(2cqi - 5px),6px);--igs-segment-gap:clamp(0px,calc(1.5cqi - 4px),5px);--igs-segment-font:clamp(9px,calc(5px + 1.5cqi),12px);--igs-segment-icon:clamp(8px,calc(3px + 2cqi),15px);container-type:inline-size",
    "segmentedButtonBox": ".igs-segmented-btn{box-sizing:border-box;width:100%;height:32px;min-width:0;margin:0;padding:0 var(--igs-segment-pad)",
    "flatSegmentedIndicator": ".igs-segmented-indicator{display:none",
    "mobileMedia": "@media (max-width:640px)",
    "navItemActive": ".igs-settings-nav-item.is-active{background:var(--igs-settings-raised);color:var(--igs-settings-ink);font-weight:600",
    "pageTabs": ".igs-page-tabs{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:2px;margin:0 0 12px;padding:3px;overflow-x:auto",
    "pageTabActive": ".igs-page-tab.is-active{background:var(--igs-settings-raised)",
    "navDrawer": "transform:translateX(-100%)",
    "wideShell": "--igs-settings-width:min(980px,calc(var(--igs-settings-vw) - 48px))"
  },
